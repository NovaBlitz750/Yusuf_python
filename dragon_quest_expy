    slow_print("  ⚔️  Arena, 📋 Quests, 🔨 Forge available between floors!")
    divider(); pause(2)

    floor=1; total=25

    while hero.is_alive() and floor<=total:

        # Quest auto-check
        qb.check_quests(hero, qb)

        # ── BOSS FLOOR ─────────────────────────────
        if floor in bosses:
            clear(); divider("═")
            slow_print(f"  ⚠️  FLOOR {floor} — BOSS BATTLE!")
            divider("═"); pause(0.8)
            boss=bosses[floor]; boss.hp=boss.max_hp; boss.statuses={}
            result=battle(hero, boss, qb)
            if result=="win":
                hero.floors_cleared+=1; floor+=1
            elif result=="lose":
                break
            else:
                slow_print("  ⚠️  Cannot flee from a Boss!"); pause(1)
            continue

        # ── NORMAL FLOOR ───────────────────────────
        clear(); divider()
        slow_print(f"  🏰 FLOOR {floor} / {total}   |   Kills: {hero.kills}   |   Quests: {hero.quests_done}")
        divider()
        print("  [1] Explore       (fight + random event)")
        print("  [2] Elite Battle  (harder fight, better loot)")
        print("  [3] View Stats")
        print("  [4] Visit Shop")
        print("  [5] Rest at Inn")
        print("  [6] Arena         (3 waves, big prize)")
        print("  [7] Quest Board")
        print("  [8] The Forge     (crafting)")
        print("  [9] Quit")
        divider()

        c=input("  What do you do? ").strip()

        if c=="1":
            floor_event(hero, floor)
            if not hero.is_alive(): break
            enemy=get_enemy(floor)
            result=battle(hero, enemy, qb)
            if result=="win":
                hero.floors_cleared+=1; floor+=1
            elif result=="lose": break

        elif c=="2":
            slow_print("  ⭐ Seeking an Elite enemy...")
            pause(0.5)
            elite=make_elites(floor)
            result=battle(hero, elite, qb)
            if result=="win":
                hero.floors_cleared+=1; floor+=1
            elif result=="lose": break

        elif c=="3":
            clear(); divider(); hero.show_stats(); divider()
            input("  Press Enter...")

        elif c=="4":
            visit_shop(hero)

        elif c=="5":
            visit_inn(hero)

        elif c=="6":
            visit_arena(hero, floor, qb)

        elif c=="7":
            qb.offer_quests(hero)
            qb.check_quests(hero, qb)

        elif c=="8":
            visit_forge(hero)

        elif c=="9":
            slow_print("  👋 Farewell, hero!"); return
        else:
            slow_print("  ❓ Invalid choice.")

    # ── END SCREEN ────────────────────────────────
    clear(); divider("═")
    if floor>total:
        slow_print("  🎉🎉  YOU WIN! THE DRAGON LORD IS DEFEATED!  🎉🎉")
        slow_print(f"  {hero.name} is crowned the greatest hero of all time! 👑")
    else:
        slow_print("  💀 GAME OVER")
        slow_print(f"  {hero.name} fell on Floor {floor}.")
