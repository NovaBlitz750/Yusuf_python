class Hero:
    def __init__(self, name, cls):
        self.name     = name
        self.cls      = cls
        self.level    = 1
        self.xp       = 0
        self.xp_next  = 40
        self.gold     = 20
        self.potions  = 3
        self.elixirs  = 0
        self.statuses = {}
        self.kills    = 0
        self.floors_cleared = 0
        self.quests_done    = 0
        self.arena_wins     = 0
        self.crafts_made    = 0
        self.total_dmg      = 0
        self.revive_used    = False

        self.weapon    = WEAPONS[0].copy()
        self.armor     = ARMORS[0].copy()
        self.accessory = ACCESSORIES[0].copy()

        base = {
            "Warrior": {"hp":140,"atk":17,"def":11,"mp":28,"sp":1.0},
            "Mage":    {"hp":78, "atk":10,"def":4, "mp":80,"sp":1.5},
            "Rogue":   {"hp":105,"atk":21,"def":7, "mp":40,"sp":1.1},
            "Paladin": {"hp":120,"atk":14,"def":13,"mp":45,"sp":1.25},
        }[cls]

        self.max_hp   = base["hp"]
        self.hp       = base["hp"]
        self.base_atk = base["atk"]
        self.base_def = base["def"]
        self.mp       = base["mp"]
        self.max_mp   = base["mp"]
        self.sp_power = base["sp"]

        self.skills = [s.copy() for s in ALL_SKILLS[cls] if s["unlocked_at"] <= 1]

    @property
    def atk(self):
        a = self.base_atk + self.weapon["atk"] + self.accessory["bonus"].get("atk",0) + self.accessory["bonus"].get("all",0)
        if "berserk"   in self.statuses: a = int(a * 1.6)
        if "empowered" in self.statuses: a = int(a * 1.3)
        if "weakened"  in self.statuses: a = int(a * 0.75)
        return a

    @property
    def defense(self):
        d = self.base_def + self.armor["def"] + self.accessory["bonus"].get("all",0)
        if "berserk" in self.statuses: d = int(d * 0.7)
        if "frozen"  in self.statuses: d = int(d * 0.55)
        return d

    def is_alive(self): return self.hp > 0

    def unlock_skills(self):
        have = {s["name"] for s in self.skills}
        for s in ALL_SKILLS[self.cls]:
            if s["unlocked_at"] <= self.level and s["name"] not in have:
                self.skills.append(s.copy())
                slow_print(f"  🌟 SKILL UNLOCKED: {s['name']}! — {s['desc']}")

    def apply_status_tick(self):
        remove = []
        for st, turns in list(self.statuses.items()):
            if st == "poison":
                d = random.randint(5,10); self.hp=max(0,self.hp-d); slow_print(f"  ☠️  Poison: -{d} HP!")
            elif st == "burn":
                d = random.randint(4,8);  self.hp=max(0,self.hp-d); slow_print(f"  🔥 Burn: -{d} HP!")
            elif st == "bleed":
                d = random.randint(3,6);  self.hp=max(0,self.hp-d); slow_print(f"  🩸 Bleed: -{d} HP!")
            elif st == "blessed":
                h = random.randint(6,12); self.hp=min(self.max_hp,self.hp+h); slow_print(f"  ✨ Blessed: +{h} HP!")
            elif st == "regen":
                h = random.randint(8,15); self.hp=min(self.max_hp,self.hp+h); slow_print(f"  💚 Regen: +{h} HP!")
            if st not in ("death_mark","resurrection_ready","shielded","revive_used"):
                self.statuses[st] = turns - 1
                if self.statuses[st] <= 0: remove.append(st)
        for st in remove:
            del self.statuses[st]; slow_print(f"  ✅ {st.capitalize()} wore off.")

    def add_status(self, st, turns):
        self.statuses[st] = turns
        emoji = STATUS.get(st,{}).get("emoji","❓")
        slow_print(f"  {emoji} {self.name} is now {st}! ({turns} turns)")

    def show_stats(self):
        st_str = " ".join(STATUS.get(s,{}).get("emoji","?") for s in self.statuses) or "—"
        bar    = hp_bar(self.hp, self.max_hp)
        print(f"  🧙 {self.name} [{self.cls}]  Lv.{self.level}  {st_str}")
        print(f"  ❤️  [{bar}] {self.hp}/{self.max_hp}")
        print(f"  💎 MP: {self.mp}/{self.max_mp}   ⚔️  ATK:{self.atk}   🛡️ DEF:{self.defense}")
        print(f"  🗡️  {self.weapon['name']}  🥋 {self.armor['name']}  💍 {self.accessory['name']}")
        print(f"  ✨ XP:{self.xp}/{self.xp_next}  💰 {self.gold}g  🧪×{self.potions}  💊×{self.elixirs}")
        if self.skills:
            sk = ", ".join(s["name"] for s in self.skills)
            print(f"  🌟 Skills: {sk}")

    def normal_attack(self, enemy):
        if "blind" in self.statuses and random.random() < 0.35:
            slow_print(f"  🌫️  You swing blindly and miss!")
            return 0
        if self.armor["name"] == "Shadow Cloak" and random.random() < 0.12:
            slow_print(f"  💨 {enemy.name} attacks — you dodge!"); return 0
        if self.accessory["bonus"].get("block") and random.random() < self.accessory["bonus"]["block"]/100:
            slow_print(f"  🛡️  Blocked!"); return 0

        crit  = random.random() < (0.15 + self.accessory["bonus"].get("crit",0)/100 + self.accessory["bonus"].get("all",0)/200)
        ignore= 3 if "Shadow" in self.weapon["name"] else (8 if "Void" in self.weapon["name"] else 0)
        dmg   = max(1, self.atk - max(0, enemy.defense - ignore) + random.randint(-3,7))
        if "marked" in enemy.statuses: dmg = int(dmg * 1.30)
        if crit: dmg = int(dmg * 2.0); slow_print(f"  💥 CRITICAL! {self.name} deals {dmg} damage!")
        else:    slow_print(f"  ⚔️  {self.name} attacks for {dmg} damage!")

        # Weapon procs
        wn = self.weapon["name"]
        if wn == "Flame Sword"  and random.random()<0.20: enemy.add_status("burn",3)
        if wn == "Thunder Blade" and random.random()<0.15: enemy.add_status("stun",1)
        if wn == "Void Saber"   and random.random()<0.25: enemy.add_status("bleed",3)
        if wn == "Dragon Fang"  and random.random()<0.30:
            enemy.add_status("burn",3); enemy.add_status("bleed",2)
        if wn == "Celestial Blade": dmg = int(dmg * 1.10)

        # Void Armor reflect
        if enemy.armor_name if hasattr(enemy,"armor_name") else False:
            pass
        if self.armor["name"] == "Void Armor" and random.random()<0.10:
            reflect = int(dmg * 0.10)
            enemy.hp -= reflect
            slow_print(f"  🔄 Void Armor reflects {reflect} damage!")

        enemy.hp -= dmg
        self.total_dmg += dmg
        return dmg

    def use_skill(self, skill, enemy):
        name = skill["name"]
        mp   = skill["mp"]

        if name == "Mana Surge":
            cost_hp = 20
            gain_mp = min(self.max_mp - self.mp, 30)
            if self.hp <= cost_hp:
                slow_print("  ❌ Not enough HP for Mana Surge!"); return False
            self.hp -= cost_hp; self.mp = min(self.max_mp, self.mp + gain_mp)
            slow_print(f"  ⚡ Mana Surge! -{cost_hp} HP, +{gain_mp} MP!"); return True

        if self.mp < mp:
            slow_print(f"  ❌ Need {mp} MP (have {self.mp})."); return False
        self.mp -= mp

        sp = self.sp_power * (1 + self.accessory["bonus"].get("spell_power",0)/100)
        if self.weapon["name"] == "Celestial Blade": sp *= 1.20

        def deal(dmg):
            if "marked" in enemy.statuses: dmg = int(dmg * 1.30)
            enemy.hp -= dmg
            self.total_dmg += dmg
            return dmg

        if name == "Shield Bash":
            d = deal(int(self.atk*1.3 + random.randint(10,18)))
            slow_print(f"  🛡️  Shield Bash! {d} damage!")
            if random.random()<0.40: enemy.add_status("stun",1)

        elif name == "Whirlwind":
            hits=random.randint(2,4); total=sum(max(1,int(self.atk*0.6+random.randint(4,9))) for _ in range(hits))
            deal(total); slow_print(f"  🌀 Whirlwind! {hits} hits, {total} total!")

        elif name == "Berserk Mode":
            self.statuses["berserk"] = 3; slow_print(f"  😡 BERSERK MODE! +60% ATK for 3 turns!")

        elif name == "War Cry":
            enemy.add_status("weakened",3); slow_print(f"  📢 WAR CRY! Enemy weakened for 3 turns!")

        elif name == "Earthquake":
            d=deal(int((self.atk*2.8+random.randint(25,40))*sp))
            slow_print(f"  🌍 EARTHQUAKE! {d} damage!")

        elif name == "Titan Smash":
            saved_def=enemy.defense; enemy.defense=0
            d=deal(self.atk*2+random.randint(20,35)); enemy.defense=saved_def
            slow_print(f"  🔨 TITAN SMASH! {d} damage, ignoring all defense!")

        elif name == "Unbreakable":
            self.statuses["shielded"]=2; slow_print(f"  🛡️  UNBREAKABLE! Blocking attacks for 2 turns!")

        elif name == "Ragnarok":
            d=deal(int(self.atk*3+random.randint(30,50)))
            self.add_status("bleed",3)
            slow_print(f"  ⚡ RAGNAROK! {d} devastating damage! (you bleed)")

        elif name == "Fireball":
            d=deal(int((45+random.randint(-8,14))*sp))
            slow_print(f"  🔥 Fireball! {d} damage!")
            if random.random()<0.25: enemy.add_status("burn",3)

        elif name == "Blizzard":
            d=deal(int((42+random.randint(-6,12))*sp))
            slow_print(f"  ❄️  Blizzard! {d} damage!")
            if random.random()<0.30: enemy.add_status("frozen",2)

        elif name == "Thunder":
            d=deal(int((50+random.randint(-8,15))*sp))
            slow_print(f"  ⚡ Thunder! {d} damage!")
            if random.random()<0.35: enemy.add_status("stun",1)

        elif name == "Arcane Bolt":
            d = self.base_atk*2 + int(30*sp) + random.randint(10,20)
            deal(d); slow_print(f"  🔮 Arcane Bolt! {d} pure magic damage, ignores DEF!")

        elif name == "Meteor Strike":
            d=deal(int((100+random.randint(-12,22))*sp))
            slow_print(f"  ☄️  METEOR STRIKE! {d} damage!")

        elif name == "Blizzard Storm":
            d=deal(int((130+random.randint(-15,25))*sp))
            slow_print(f"  🌨️  BLIZZARD STORM! {d} damage!")
            enemy.add_status("frozen",3)

        elif name == "Armageddon":
            d=deal(int((200+random.randint(-20,40))*sp))
            slow_print(f"  💥 ARMAGEDDON! {d} catastrophic damage!")

        elif name == "Shadowstep":
            d = self.atk*2 + random.randint(15,25)
            deal(d); slow_print(f"  🌑 Shadowstep! {d} damage, bypasses defense!")

        elif name == "Poison Blade":
            d = max(1, self.atk-enemy.defense+random.randint(6,12))
            deal(d); slow_print(f"  🗡️  Poison Blade! {d} damage + poison!")
            enemy.add_status("poison",5)

        elif name == "Smoke Bomb":
            enemy.add_status("bleed",3); slow_print(f"  💨 Smoke Bomb! Enemy bleeds for 3 turns!")
            return "escape"

        elif name == "Mark Target":
            enemy.add_status("marked",4); slow_print(f"  🎯 Marked! Enemy takes +30% damage for 4 turns!")

        elif name == "Death Mark":
            self.statuses["death_mark"]=1; slow_print(f"  💀 DEATH MARK! Next attack deals triple damage!")

        elif name == "Shadow Clone":
            d1 = max(1,self.atk-enemy.defense+random.randint(-2,5))
            d2 = max(1,self.atk-enemy.defense+random.randint(-2,5))
            deal(d1+d2); slow_print(f"  👥 Shadow Clone! Two strikes: {d1} + {d2} = {d1+d2} total!")

        elif name == "Vanish":
            self.statuses["shielded"]=1; slow_print(f"  🌫️  Vanish! You disappear — enemy skips their turn!")

        elif name == "Assassination":
            d = int(enemy.max_hp * 0.60); deal(d)
            slow_print(f"  🗡️  ASSASSINATION! Deal 60% of enemy max HP: {d} damage!")

        elif name == "Holy Strike":
            d=deal(int((self.atk*1.5+random.randint(12,20))*sp))
            h=random.randint(10,20); self.hp=min(self.max_hp,self.hp+h)
            slow_print(f"  ✝️  Holy Strike! {d} damage, healed {h} HP!")

        elif name == "Divine Shield":
            self.statuses["shielded"]=1; slow_print(f"  🛡️  Divine Shield! Next attack blocked!")

        elif name == "Smite":
            d=deal(int((55+random.randint(-10,16))*sp))
            slow_print(f"  ⚡ Smite! {d} damage!")
            enemy.add_status("cursed",3)

        elif name == "Consecrate":
            self.add_status("regen",4); self.add_status("blessed",4)
            slow_print(f"  🌿 Consecrate! Regen + Blessed for 4 turns!")

        elif name == "Resurrection":
            self.statuses["resurrection_ready"]=99
            slow_print(f"  🌟 Resurrection charged! You will rise if you fall!")

        elif name == "Holy Nova":
            d=deal(int((80+random.randint(-10,20))*sp))
            h=random.randint(15,28); self.hp=min(self.max_hp,self.hp+h)
            self.statuses={k:v for k,v in self.statuses.items()
                           if k not in ("poison","burn","bleed","cursed","frozen","stun","blind")}
            slow_print(f"  💫 Holy Nova! {d} damage, +{h} HP, all debuffs cleansed!")

        elif name == "Sacred Flame":
            d=deal(int((65+random.randint(-8,18))*sp))
            slow_print(f"  🔥 Sacred Flame! {d} damage!")
            enemy.add_status("burn",4); enemy.add_status("blind",3)

        elif name == "Divine Judgment":
            d=deal(int((150+random.randint(-15,30))*sp))
            h=random.randint(20,35); self.hp=min(self.max_hp,self.hp+h)
            self.add_status("regen",5)
            slow_print(f"  ⚡ DIVINE JUDGMENT! {d} holy damage! Healed {h} HP! Regen activated!")

        return True

    def use_potion(self):
        if self.potions<=0: slow_print("  ❌ No potions!"); return
        h=random.randint(30,50); self.hp=min(self.max_hp,self.hp+h)
        self.potions-=1; slow_print(f"  🧪 Potion! +{h} HP ({self.potions} left)")

    def use_elixir(self):
        if self.elixirs<=0: slow_print("  ❌ No elixirs!"); return
        self.hp=self.max_hp; self.mp=self.max_mp
        self.elixirs-=1; slow_print(f"  💊 Elixir! Fully restored! ({self.elixirs} left)")

    def gain_xp(self, amount):
        self.xp+=amount; slow_print(f"  ✨ +{amount} XP!")
        while self.xp>=self.xp_next: self.level_up()

    def level_up(self):
        self.level+=1; self.xp-=self.xp_next; self.xp_next=int(self.xp_next*1.42)
        hp=random.randint(14,22); a=random.randint(2,5); d=random.randint(1,3); m=random.randint(7,13)
        self.max_hp+=hp; self.hp=self.max_hp
        self.base_atk+=a; self.base_def+=d; self.max_mp+=m; self.mp=self.max_mp
        divider()
        slow_print(f"  🎉 LEVEL UP! Now Level {self.level}!")
        slow_print(f"     +{hp} HP  +{a} ATK  +{d} DEF  +{m} MP")
        self.unlock_skills(); divider()

    def get_title(self):
        if self.level>=20 and self.kills>=50: return "Dragon Slayer"
        if self.kills>=40: return "Monster Hunter"
        if self.quests_done>=5: return "Hero of the Realm"
        if self.arena_wins>=3: return "Arena Champion"
        if self.crafts_made>=3: return "Master Crafter"
        if self.level>=15: return "Veteran Adventurer"
        if self.floors_cleared>=15: return "Dungeon Crawler"
        return "Adventurer"


