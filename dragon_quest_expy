    print("  [4] Paladin  — Self-heal, curses, divine judgment")
    divider()
    cls={"1":"Warrior","2":"Mage","3":"Rogue","4":"Paladin"}.get(
        input("  Choice (1-4): ").strip(),"Warrior")

    hero   = Hero(name, cls)
