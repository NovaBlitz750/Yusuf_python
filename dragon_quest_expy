def clear():
    os.system('cls' if os.name == 'nt' else 'clear')

def slow_print(text, delay=0.026):
    for char in text:
        print(char, end='', flush=True)
        time.sleep(delay)
    print()

def divider(char="═", n=52):
    print(char * n)

def pause(s=1.2):
    time.sleep(s)

def hp_bar(current, maximum, length=20):
    filled = int((max(0, current) / maximum) * length)
    return "█" * filled + "░" * (length - filled)

