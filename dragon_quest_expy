        else: slow_print("  ❌ Not enough gold.")
    pause(1.2)


# ══════════════════════════════════════════════════════════════
#  SHOP
# ══════════════════════════════════════════════════════════════
def visit_shop(hero):
    while True:
        clear(); divider(); slow_print("  🏪 BLACKSMITH & ITEM SHOP"); divider()
        print("  ── CONSUMABLES ──")
        print("  [1] Potion        8g   Restore 30-50 HP")
        print("  [2] Elixir       28g   Full HP & MP")
        print("  [3] Antidote      6g   Clear all debuffs")
        print("  [4] Power Dust   15g   +4 ATK permanently")
        print("  [5] Iron Plate   15g   +4 DEF permanently")
        print()
        print("  ── WEAPONS (better = replaces current) ──")
        for i,w in enumerate(WEAPONS[1:],6):
            eq=" ◄" if hero.weapon["name"]==w["name"] else ""
            print(f"  [{i}] {w['name']:<17} {w['price']}g  +{w['atk']} ATK  {w['desc']}{eq}")
        print()
        print("  ── ARMOR ──")
        for i,a in enumerate(ARMORS[1:],14):
            eq=" ◄" if hero.armor["name"]==a["name"] else ""
            print(f"  [{i}] {a['name']:<17} {a['price']}g  +{a['def']} DEF  {a['desc']}{eq}")
        print()
        print("  ── ACCESSORIES ──")
        for i,ac in enumerate(ACCESSORIES[1:],22):
            eq=" ◄" if hero.accessory["name"]==ac["name"] else ""
            print(f"  [{i}] {ac['name']:<17} {ac['price']}g  {ac['desc']}{eq}")
        print()
        print("  [0] Leave")
        divider(); print(f"  💰 Gold: {hero.gold}"); divider()
        c=input("  Choose: ").strip()
        if c=="0": break
        try:
            idx=int(c)
            if idx==1:
                if hero.gold>=8: hero.gold-=8;hero.potions+=1;slow_print("  🧪 Bought Potion!")
                else: slow_print("  ❌ Not enough gold.")
            elif idx==2:
                if hero.gold>=28: hero.gold-=28;hero.elixirs+=1;slow_print("  💊 Bought Elixir!")
                else: slow_print("  ❌ Not enough gold.")
            elif idx==3:
                if hero.gold>=6: hero.gold-=6;hero.statuses.clear();slow_print("  🍵 Debuffs cleared!")
                else: slow_print("  ❌ Not enough gold.")
            elif idx==4:
                if hero.gold>=15: hero.gold-=15;hero.base_atk+=4;slow_print("  ⚔️  +4 ATK!")
                else: slow_print("  ❌ Not enough gold.")
            elif idx==5:
                if hero.gold>=15: hero.gold-=15;hero.base_def+=4;slow_print("  🛡️  +4 DEF!")
                else: slow_print("  ❌ Not enough gold.")
            elif 6<=idx<=13:
                w=WEAPONS[idx-5]
                if hero.gold>=w["price"]:
                    if hero.weapon["atk"]>=w["atk"]: slow_print("  ⚠️  Already have better weapon.")
                    else: hero.gold-=w["price"];hero.weapon=w.copy();slow_print(f"  ⚔️  Equipped {w['name']}!")
                else: slow_print("  ❌ Not enough gold.")
            elif 14<=idx<=21:
                a=ARMORS[idx-13]
                if hero.gold>=a["price"]:
                    if hero.armor["def"]>=a["def"]: slow_print("  ⚠️  Already have better armor.")
                    else: hero.gold-=a["price"];hero.armor=a.copy();slow_print(f"  🥋 Equipped {a['name']}!")
                else: slow_print("  ❌ Not enough gold.")
            elif 22<=idx<=30:
                ac=ACCESSORIES[idx-21]
                if hero.gold>=ac["price"]:
                    hero.gold-=ac["price"];hero.accessory=ac.copy();slow_print(f"  💍 Equipped {ac['name']}!")
                else: slow_print("  ❌ Not enough gold.")
            else: slow_print("  ❓ Invalid.")
        except ValueError: slow_print("  ❓ Invalid.")
        pause(0.8)


# ══════════════════════════════════════════════════════════════
#  BATTLE
# ══════════════════════════════════════════════════════════════
def battle(hero, enemy, qb=None, arena=False):
    clear(); divider()
    if enemy.boss:   slow_print(f"  ⚠️  BOSS: {enemy.emoji} {enemy.name}!"); slow_print("  Prepare yourself!")
    elif enemy.elite: slow_print(f"  ⭐ ELITE ENEMY: {enemy.emoji} {enemy.name}!")
    else:             slow_print(f"  ⚔️  {enemy.emoji} {enemy.name} appears!")
    divider(); pause(0.9)

    turn=0
    while hero.is_alive() and enemy.is_alive():
        turn+=1
        hero.apply_status_tick(); enemy.apply_status_tick()
        if not hero.is_alive(): break

        # Mana ring regen
        if hero.accessory["bonus"].get("mp_regen"):
            hero.mp=min(hero.max_mp, hero.mp+hero.accessory["bonus"]["mp_regen"])

        # Quest check
        if qb: qb.check_quests(hero, qb)

        clear()
        print(f"\n  ─── Turn {turn} ───")
        enemy.hp_bar_str(); print()
        hero.show_stats(); divider()
        print("  [1] Attack        [2] Use Skill")
        print("  [3] Use Potion    [4] Use Elixir")
        print("  [5] Defend (-40%) [6] Inspect Enemy")
        if not arena and not enemy.boss:
            print("  [7] Run Away")
        divider()

        action=input("  Action: ").strip()
        defending=False

        if action=="1":
            if "death_mark" in hero.statuses:
                base=hero.normal_attack(enemy)
                bonus=base*2; enemy.hp-=bonus
                slow_print(f"  💀 DEATH MARK TRIGGERS! +{bonus} bonus damage!")
                del hero.statuses["death_mark"]
            else:
                hero.normal_attack(enemy)

        elif action=="2":
            if not hero.skills: slow_print("  ❌ No skills!"); continue
            print()
            for i,s in enumerate(hero.skills,1):
                print(f"  [{i}] {s['name']:<17} {s['mp']} MP  {s['desc']}")
            print("  [0] Cancel")
            sc=input("  Skill: ").strip()
            if sc=="0": continue
            try:
                skill=hero.skills[int(sc)-1]
                result=hero.use_skill(skill,enemy)
                if result=="escape":
                    slow_print("  💨 Escaped with Smoke Bomb!"); pause(1); return "escaped"
                if not result: continue
                if qb: qb.skill_uses+=1
            except: slow_print("  ❓ Invalid."); continue

        elif action=="3":
            hero.use_potion()
            if qb: qb.potion_uses+=1

        elif action=="4":
            hero.use_elixir()

        elif action=="5":
            defending=True; slow_print("  🛡️  Defending — incoming damage reduced by 40%.")

        elif action=="6":
            clear(); divider()
            slow_print(f"  🔍 Inspecting {enemy.name}...")
            print(f"  HP: {enemy.hp}/{enemy.max_hp}  ATK: {enemy.atk}  DEF: {enemy.defense}")
            print(f"  Weakness: {enemy.weakness or 'Unknown'}  Boss: {'Yes' if enemy.boss else 'No'}")
            if enemy.statuses:
                print(f"  Statuses: {', '.join(enemy.statuses.keys())}")
            divider(); input("  Press Enter..."); continue

        elif action=="7" and not arena and not enemy.boss:
            if random.random()<0.38: slow_print("  🏃 Escaped!"); pause(1); return "escaped"
            else: slow_print("  ❌ Couldn't escape!")
        else:
            slow_print("  ❓ Invalid.")

        # Enemy turn
        if enemy.is_alive():
            dmg=enemy.attack(hero)
            if defending and dmg>0:
                red=int(dmg*0.40); hero.hp=min(hero.max_hp,hero.hp+red)
                slow_print(f"  🛡️  Defense saved {red} damage!")

        # Phoenix Feather / Resurrection
        if not hero.is_alive():
            if "resurrection_ready" in hero.statuses:
                del hero.statuses["resurrection_ready"]
                hero.hp=hero.max_hp//2
                slow_print("  🌟 RESURRECTION! You rise again!"); pause(1)
            elif hero.accessory["bonus"].get("revive") and not hero.revive_used:
                hero.revive_used=True; hero.hp=hero.max_hp//2
                slow_print("  🪶 Phoenix Feather activates! Revived with half HP!"); pause(1)

        pause(0.45)

    if hero.is_alive():
        divider(); slow_print(f"  🏆 Victory! {enemy.name} defeated!")
        hero.kills+=1
        loot=enemy.gold+random.randint(-4,10); hero.gold+=loot
        if qb: qb.total_gold+=loot
        hero.gain_xp(enemy.xp)
        slow_print(f"  💰 Looted {loot} gold!")
        if random.random()<0.12: hero.potions+=1; slow_print("  🎁 Rare drop: Potion!")
        if (enemy.boss or enemy.elite) and random.random()<0.25:
            hero.elixirs+=1; slow_print("  🎁 Special drop: Elixir!")
        pause(1.5); return "win"
    else:
        divider(); slow_print(f"  💀 {hero.name} has fallen..."); pause(2); return "lose"


