class Enemy:
    def __init__(self, name, hp, atk, defense, xp, gold, emoji,
                 skills=None, weakness=None, boss=False, elite=False):
        self.name     = name
        self.hp       = hp
        self.max_hp   = hp
        self.atk      = atk
        self.defense  = defense
        self.xp       = xp
        self.gold     = gold
        self.emoji    = emoji
        self.skills   = skills or []
        self.weakness = weakness
        self.boss     = boss
        self.elite    = elite
        self.statuses = {}

    def is_alive(self): return self.hp > 0

    def add_status(self, st, turns):
        self.statuses[st]=turns
        emoji=STATUS.get(st,{}).get("emoji","❓")
        slow_print(f"  {emoji} {self.name} is now {st}!")

    def apply_status_tick(self):
        rm=[]
        for st, turns in list(self.statuses.items()):
            if st in ("poison","burn","bleed"):
                d=random.randint(6,12); self.hp=max(0,self.hp-d)
                slow_print(f"  {STATUS.get(st,{}).get('emoji','💥')} {self.name} takes {d} from {st}!")
            self.statuses[st]=turns-1
            if self.statuses[st]<=0: rm.append(st)
        for st in rm: del self.statuses[st]

    def attack(self, hero):
        if "stun" in self.statuses or "frozen" in self.statuses:
            slow_print(f"  {self.name} is immobilised!"); return 0
        if "shielded" in hero.statuses:
            slow_print(f"  🛡️  Shield blocks the attack!"); del hero.statuses["shielded"]; return 0
        if random.random()<0.08:
            slow_print(f"  💨 {self.name} missed!"); return 0
        if (self.boss or self.elite) and self.skills and random.random()<0.38:
            return self._special(hero)
        dmg=max(1, self.atk-hero.defense+random.randint(-3,6))
        if "cursed" in self.statuses: dmg=max(1,dmg//2)
        slow_print(f"  {self.emoji} {self.name} attacks for {dmg} damage!")
        hero.hp-=dmg; return dmg

    def _special(self, hero):
        skill=random.choice(self.skills)
        slow_print(f"  {self.emoji} {self.name} uses {skill['name']}!")
        pause(0.4)
        dmg=skill.get("dmg",0)
        if dmg:
            actual=max(1,dmg-hero.defense//2+random.randint(-5,10))
            hero.hp-=actual; slow_print(f"  💥 {actual} damage!")
        if "status" in skill:
            hero.add_status(skill["status"],skill.get("turns",2))
        return dmg

    def hp_bar_str(self):
        bar=hp_bar(self.hp,self.max_hp,22)
        tag=" ⭐ELITE" if self.elite else (" 💀BOSS" if self.boss else "")
        st_str=" ".join(STATUS.get(s,{}).get("emoji","?") for s in self.statuses) if self.statuses else ""
        print(f"  {self.emoji}{tag} {self.name}")
        print(f"  [{bar}] {max(0,self.hp)}/{self.max_hp} HP  {st_str}")
        if self.weakness: print(f"  🔍 Weak to: {self.weakness}")


