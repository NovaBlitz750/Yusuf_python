class QuestBoard:
    def __init__(self):
        self.active = []
        self.skill_uses   = 0
        self.potion_uses  = 0
        self.total_gold   = 0

    def offer_quests(self, hero):
        clear(); divider()
        slow_print("  📋 QUEST BOARD")
        divider()
        available=[q for q in QUEST_POOL if q not in self.active and len(self.active)<3]
        if not available:
            slow_print("  No new quests available."); pause(1); return
        offer=random.sample(available, min(3, len(available)))
        for i,q in enumerate(offer,1):
            print(f"  [{i}] {q['name']:<20} {q['desc']}")
            print(f"       Reward: {q['gold']}g + {q['xp']} XP")
        print("  [0] Leave")
        divider()
        c=input("  Accept quest (1-3) or 0: ").strip()
        if c in ["1","2","3"]:
            idx=int(c)-1
            if idx<len(offer):
                q=offer[idx]; self.active.append(q)
                slow_print(f"  ✅ Quest accepted: {q['name']}!")
        pause(0.8)

    def check_quests(self, hero, quest_board):
        done=[]
        for q in self.active:
            completed=False
            if q["type"]=="kills"   and hero.kills>=q["goal"]:      completed=True
            if q["type"]=="floors"  and hero.floors_cleared>=q["goal"]: completed=True
            if q["type"]=="survive" and hero.hp>20:                  completed=True
            if q["type"]=="skills"  and quest_board.skill_uses>=q["goal"]: completed=True
            if q["type"]=="gold"    and quest_board.total_gold>=q["goal"]: completed=True
            if q["type"]=="potions" and quest_board.potion_uses>=q["goal"]: completed=True
            if completed: done.append(q)
        for q in done:
            self.active.remove(q)
            hero.gold+=q["gold"]; hero.gain_xp(q["xp"])
            hero.quests_done+=1
            slow_print(f"  🏆 QUEST COMPLETE: {q['name']}! +{q['gold']}g +{q['xp']} XP!")
            divider(); pause(0.8)


